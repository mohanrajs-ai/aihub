# Stage 1: Build Standalone Admin Console React + TypeScript Frontend
FROM node:20-slim AS frontend-admin-builder
WORKDIR /workspace/frontend-admin
COPY frontend-admin/package*.json ./
RUN npm install --no-audit --no-fund
COPY frontend-admin/ ./
RUN npm run build

# Stage 2: Python FastAPI Standalone Admin Console Runtime (Port 8082)
FROM python:3.12-slim AS runtime
WORKDIR /workspace
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace/backend-admin \
    PORT=8082

COPY backend-admin/requirements.txt ./backend-admin/requirements.txt
RUN pip install --no-cache-dir -r backend-admin/requirements.txt

COPY backend-admin/ ./backend-admin/
COPY --from=frontend-admin-builder /workspace/frontend-admin/dist ./frontend-admin/dist

RUN useradd --create-home --shell /bin/bash appuser && chown -R appuser:appuser /workspace
USER appuser

EXPOSE 8082
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8082"]
