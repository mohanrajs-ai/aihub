# ==============================================================================
# Gemini AI Hub — User Portal Deployment Configuration Template
# Copy this file to user-portal/deploy/config.env and fill in your values:
#   cp user-portal/deploy/config.env.example user-portal/deploy/config.env
# ==============================================================================

# 1. Target Google Cloud Project & Region (Required)
export GCP_PROJECT_ID="<YOUR_GCP_PROJECT_ID>"
export GCP_REGION="us-central1"

# 2. GitHub Repository Configuration (Optional — used for GitHub source checkout & Cloud Build CI/CD trigger)
export GITHUB_REPO_URL="https://github.com/<YOUR_GITHUB_ORG_OR_USER>/<YOUR_GITHUB_REPO>.git"
export GITHUB_REPO_OWNER="<YOUR_GITHUB_ORG_OR_USER>"
export GITHUB_REPO_NAME="<YOUR_GITHUB_REPO>"
export GITHUB_BRANCH="main"

# 3. Artifact Registry Configuration
export AR_REPO="ge-user-portal-repo"
export IMAGE_NAME="ge-user-portal"
export IMAGE_TAG="latest"

# 4. Google OAuth 2.0 Web Client Credentials (stored in GCP Secret Manager)
export GOOGLE_CLIENT_ID="<YOUR_GOOGLE_OAUTH_CLIENT_ID>.apps.googleusercontent.com"
export GOOGLE_CLIENT_SECRET="<YOUR_GOOGLE_OAUTH_CLIENT_SECRET>"

# 5. Optional VPC, Internal Load Balancer & Cloud DNS Configuration (for Terraform stack)
export VPC_NETWORK_ID=""
export VPC_EGRESS_SUBNET_ID=""
export ILB_SUBNET_ID=""
export INTERNAL_DOMAIN_NAME=""
export PRIVATE_DNS_ZONE_NAME=""
export SSL_CERTIFICATE_ID=""
