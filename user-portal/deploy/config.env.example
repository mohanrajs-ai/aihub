# ==============================================================================
# Gemini AI Hub — User Portal Deployment Configuration Template
# Copy this file to user-portal/deploy/config.env and fill in your values:
#   cp user-portal/deploy/config.env.example user-portal/deploy/config.env
# ==============================================================================

# 1. Target Google Cloud Project & Region (Required)
export GCP_PROJECT_ID="<YOUR_GCP_PROJECT_ID>"
export GCP_REGION="us-central1"

# 2. GCS Source Staging Bucket & Artifact Registry Configuration
# (If GCS_SOURCE_BUCKET is left empty, defaults to ${GCP_PROJECT_ID}-user-portal-source)
export GCS_SOURCE_BUCKET=""
export AR_REPO="ge-user-portal-repo"
export IMAGE_NAME="ge-user-portal"
export IMAGE_TAG="latest"

# 4. Google OAuth 2.0 Web Client Credentials (automatically stored in GCP Secret Manager by Terraform)
export GOOGLE_CLIENT_ID="<YOUR_GOOGLE_OAUTH_CLIENT_ID>.apps.googleusercontent.com"
export GOOGLE_CLIENT_SECRET="<YOUR_GOOGLE_OAUTH_CLIENT_SECRET>"

# 5. Internal Domain Name (SSL Certificate & Cloud DNS Private Zone are created automatically by Terraform)
export INTERNAL_DOMAIN_NAME="aihub.internal.corp"
